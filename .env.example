# SQLAlchemy SQL Server URL using ODBC Driver 18.
# URL-encode special characters in username/password.
DATABASE_URL=mssql+pyodbc://ml_user:change_me@sqlserver-host/machine_ml?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
PERSIST_PREDICTIONS=true

# Generate a long random secret in production. Never commit the real value.
ADMIN_API_KEY=replace-with-a-long-random-secret
